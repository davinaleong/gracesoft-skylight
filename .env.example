APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gracesoft_skylight
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Blank here is the correct *local* default (plain HTTP dev server). In
# production set this to true -- see _internal-docs/production-deployment.md.
SESSION_SECURE_COOKIE=

# Blank = no proxies trusted (safe default for a direct-to-PHP deployment).
# Set to '*' or a comma-separated list of proxy IPs/CIDRs in production if
# running behind a reverse proxy/load balancer -- see
# _internal-docs/production-deployment.md.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Ideally a different bucket (or cloud account) than AWS_BUCKET -- falls back
# to AWS_BUCKET if unset, but that defeats the point of an off-site backup.
AWS_BACKUP_BUCKET=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
MYSQLDUMP_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Error tracking -- no-ops entirely when SENTRY_LARAVEL_DSN is blank, safe to
# leave unset in local dev. traces_sample_rate is unset (tracing off) by
# default in config/sentry.php; set a low value (e.g. 0.2) in production once
# a real DSN is in place, not 1.0, to avoid excessive event volume/cost.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=

VITE_APP_NAME="${APP_NAME}"

# Roadmap feature flags (Laravel Pennant). A milestone is on for everyone when
# its *_ENABLED flag is true, otherwise only for the early-access emails.
# Run `php artisan pennant:purge` after changing these.
FEATURE_M0_ENABLED=false
FEATURE_EARLY_ACCESS_EMAILS=
